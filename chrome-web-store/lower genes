UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F then toggleFly()
    elseif input.KeyCode == Enum.KeyCode.Q then toggleMaster() 
    elseif input.KeyCode == Enum.KeyCode.N then toggleNoclip()
    elseif input.KeyCode == Enum.KeyCode.RightShift then
        guiEnabled = not guiEnabled
        mainGui.Enabled = guiEnabled
        reopenBtn.Visible = not guiEnabled
    end
end)

-- =====================
-- MAIN LOOP (STICKY + PROXIMITY)
-- =====================
RunService:BindToRenderStep("LowerGenesUpdate", Enum.RenderPriority.Camera.Value + 1, function()
    if mainGui.Enabled and masterActive then
        FOVCircle.Visible = true
        FOVCircle.Position = UserInputService:GetMouseLocation()
    else
        FOVCircle.Visible = false
    end

    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    -- ULTRA STICK LOGIC
    if stickyTarget and stickyTarget.Character and stickyTarget.Character:FindFirstChild("HumanoidRootPart") then
        local tRoot = stickyTarget.Character.HumanoidRootPart
        -- Offset: 0 to the side, 0 up, 1.5 studs behind. 
        -- Also matches rotation and velocity for smoothness.
        root.CFrame = tRoot.CFrame * CFrame.new(0, 0, 1.5)
        root.AssemblyLinearVelocity = tRoot.AssemblyLinearVelocity
    elseif stickyTarget then
        stickyTarget = nil
        setNoclip(false)
    end

    -- FLY LOGIC
    if flyEnabled and root:FindFirstChild("P_FlyVel") then
        local dir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then dir += camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then dir -= camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then dir -= camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then dir += camera.CFrame.RightVector end
        root.P_FlyVel.Velocity, root.P_FlyGyro.CFrame = dir * flySpeed, camera.CFrame
    end

    -- MASTER AIM LOGIC
    if masterActive and not stickyTarget then
        local target, shortest = nil, AIM_FOV
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and not isWhitelisted(plr) and plr.Character and plr.Character:FindFirstChild("Head") then
                local head = plr.Character.Head
                local pos, onScreen = camera:WorldToViewportPoint(head.Position)
                if onScreen and isVisible(head) then
                    local dist = (Vector2.new(pos.X, pos.Y) - UserInputService:GetMouseLocation()).Magnitude
                    if dist < shortest then shortest, target = dist, head end
                end
            end
        end
        if target then
            camera.CFrame = CFrame.lookAt(camera.CFrame.Position, target.Position)
            root.CFrame = CFrame.lookAt(root.Position, Vector3.new(target.Position.X, root.Position.Y, target.Position.Z))
        end
    end
end)
