            nameBtn.Text = plr.Name
            nameBtn.Font, nameBtn.TextColor3 = Enum.Font.Gotham, Color3.new(1,1,1)
            Instance.new("UICorner", nameBtn)
            
            local stickBtn = Instance.new("TextButton", container)
            stickBtn.Size = UDim2.new(0.3, 0, 1, 0)
            stickBtn.Position = UDim2.new(0.7, 0, 0, 0)
            stickBtn.BackgroundColor3 = (stickyTarget == plr) and Color3.fromRGB(200, 40, 40) or Color3.fromRGB(45, 45, 45)
            stickBtn.Text = "STICK"
            stickBtn.Font, stickBtn.TextColor3 = Enum.Font.Gotham, Color3.new(1,1,1)
            Instance.new("UICorner", stickBtn)

            stickBtn.MouseButton1Click:Connect(function()
                if stickyTarget == plr then
                    stickyTarget = nil
                    setNoclip(false)
                else
                    stickyTarget = plr
                    setNoclip(true) -- Auto Noclip so we don't get flung
                end
                updateList()
            end)
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
end

Players.PlayerAdded:Connect(updateList)
