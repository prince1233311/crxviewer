-- UTILITIES
local function isWhitelisted(plr) return WHITELIST[plr.UserId] == true end

local function isVisible(targetPart)
    local origin = camera.CFrame.Position
    local params = RaycastParams.new()
    params.FilterDescendantsInstances = {player.Character, targetPart.Parent}
    params.FilterType = Enum.RaycastFilterType.Exclude
    return workspace:Raycast(origin, targetPart.Position - origin, params) == nil 
end

local function manageESP(state)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character then
            local existing = plr.Character:FindFirstChild("PrinceESP")
            if state and not isWhitelisted(plr) then
                if not existing then
                    local h = Instance.new("Highlight", plr.Character)
                    h.Name = "PrinceESP"
                    h.FillColor = Color3.fromRGB(255, 0, 50)
                    h.FillTransparency = 0.5
                end
            elseif existing then existing:Destroy() end
        end
    end
end

-- =====================
-- SPEED HANDLER
-- =====================
local function applySpeed()
    local char = player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return end

    if speedEnabled and not flyEnabled then
        hum.WalkSpeed = walkSpeedBoost
    elseif not flyEnabled then
        hum.WalkSpeed = 16
    end
end

local function toggleSpeed()
    speedEnabled = not speedEnabled 
    speedBtn.Text = "SPEED (L): " .. (speedEnabled and "ON" or "OFF")
    speedBtn.BackgroundColor3 = speedEnabled and Color3.fromRGB(255, 0, 50) or Color3.fromRGB(25, 25, 25)
    
    applySpeed()

    -- Disconnect old connection if it exists
    if speedConnection then speedConnection:Disconnect() end

    -- Forced Listener: Re-applies speed if the game tries to change it
    if speedEnabled then
        local char = player.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            speedConnection = hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
                if speedEnabled and not flyEnabled and hum.WalkSpeed ~= walkSpeedBoost then
                    hum.WalkSpeed = walkSpeedBoost
                end
            end)
        end
    end
end

-- =====================
-- FLY HANDLER
-- =====================
local function toggleFly()
    flyEnabled = not flyEnabled
    local char = player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if flyEnabled and root and hum then
        local bv = Instance.new("BodyVelocity", root); bv.Name = "P_FlyVel"; bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
        local bg = Instance.new("BodyGyro", root); bg.Name = "P_FlyGyro"; bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
        hum.PlatformStand = true
    elseif root then
        if root:FindFirstChild("P_FlyVel") then root.P_FlyVel:Destroy() end
        if root:FindFirstChild("P_FlyGyro") then root.P_FlyGyro:Destroy() end
        if hum then hum.PlatformStand = false end
        applySpeed() -- Re-apply speed after flying
    end
    flyBtn.Text = "FLY (F): " .. (flyEnabled and "ON" or "OFF")
end

